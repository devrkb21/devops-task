# Copy to .env (git-ignored) and adjust:  cp .env.example .env

# Start the monitoring stack together with the app on plain `docker compose up`.
COMPOSE_PROFILES=monitoring

APP_VERSION=1.0.0-local
APP_ENV=local
LOG_LEVEL=info

# Optional. When set, /debug/error and /debug/slow are enabled (header X-Debug-Token).
# Generate one with:  openssl rand -hex 16
DEBUG_TOKEN=

# Grafana admin login. The stack refuses to start without a password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
